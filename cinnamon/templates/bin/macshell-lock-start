#!/usr/bin/python3
"""Start the MacShell native locker only when no locker owns its D-Bus name."""
import subprocess
from gi.repository import Gio,GLib
subprocess.run(['systemctl','--user','import-environment','DISPLAY','XAUTHORITY','DBUS_SESSION_BUS_ADDRESS','XDG_RUNTIME_DIR'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
bus=Gio.bus_get_sync(Gio.BusType.SESSION,None)
owned=bus.call_sync('org.freedesktop.DBus','/org/freedesktop/DBus','org.freedesktop.DBus','NameHasOwner',GLib.Variant('(s)',('org.cinnamon.ScreenSaver',)),None,0,2000,None).unpack()[0]
if not owned:subprocess.run(['systemctl','--user','start','macshell-lock-native.service'],check=True)
